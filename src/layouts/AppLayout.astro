---
import App from '../App';
import '../index.css';

interface Props {
  title: string;
  description: string;
  keywords: string;
  canonicalPath: string;
  body: string;
  schema: unknown;
  hydrationData?: { from?: string; to?: string };
}

const {
  title,
  description,
  keywords,
  canonicalPath,
  body,
  schema,
  hydrationData,
} = Astro.props;
const baseUrl = (import.meta.env.SITE || 'https://metro.coolhead.in').replace(/\/$/, '');
const canonicalUrl = `${baseUrl}${canonicalPath}`;
const imageUrl = `${baseUrl}/images/showcase-1200x630.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <base href="/" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://delhi-metro-react.pages.dev" />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/`} />
    <link rel="alternate" hreflang="hi" href={`${baseUrl}/?lang=hi`} />
    <link rel="alternate" hreflang="mr" href={`${baseUrl}/?lang=mr`} />
    <link rel="alternate" hreflang="bn" href={`${baseUrl}/?lang=bn`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=overlays-content" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Delhi Metro" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="scrolllaunch-verify" content="36123bd46ae1cf8ae73322369ad44c06" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Delhi Metro Route Planner" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Delhi Metro Route Planner" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Delhi Metro route planner with interactive map and journey details" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:locale:alternate" content="hi_IN" />
    <meta property="og:locale:alternate" content="mr_IN" />
    <meta property="og:locale:alternate" content="bn_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Delhi Metro route planner with interactive map and journey details" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:inline>
      html, body {
        margin: 0;
        min-height: 100%;
        background: #f4f0e8;
        font-family: "Hiragino Maru Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      .app-stage-shell {
        height: 100svh;
        overflow: hidden;
        background: #f4f0e8;
        color: #0a0a0a;
        padding: 0.5rem;
      }

      .app-stage-grid {
        display: grid;
        height: 100%;
        min-height: 0;
        gap: 1rem;
      }

      .app-map-frame {
        position: relative;
        min-height: 0;
        overflow: hidden;
        border: 1px solid #e5e5e5;
        border-radius: 0.5rem;
        background: #f4f0e8;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
      }

      .app-map-fallback {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        min-height: inherit;
        overflow: hidden;
        border: 0;
        background: #f4f0e8;
        padding: 0;
        color: #0a0a0a;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }

      .app-map-fallback-picture,
      .app-map-fallback-overlay {
        position: absolute;
        inset: 0;
      }

      .app-map-fallback-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: left top;
      }

      .app-map-fallback-overlay {
        background: rgb(255 255 255 / 0.1);
      }

      .app-map-fallback-content {
        position: relative;
        z-index: 1;
        display: flex;
        height: 100%;
        flex-direction: column;
        justify-content: space-between;
        padding: 1rem;
      }

      .app-map-fallback-badge {
        width: fit-content;
        border-radius: 999px;
        background: rgb(255 255 255 / 0.95);
        padding: 0.5rem 0.75rem;
        color: #404040;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1rem;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
      }

      @media (min-width: 640px) {
        .app-stage-shell {
          padding: 1rem;
        }

        .app-map-fallback-content {
          padding: 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        .app-stage-shell {
          padding: 1.5rem;
        }

        .app-stage-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .app-map-frame-fallback {
          grid-column: span 2 / span 2;
        }
      }

      @media (prefers-color-scheme: dark) {
        .app-stage-shell,
        .app-map-frame,
        .app-map-fallback {
          background: #09090b;
          color: #fafafa;
        }

        .app-map-frame {
          border-color: #27272a;
        }

        .app-map-fallback-overlay {
          background: rgb(9 9 11 / 0.2);
        }

        .app-map-fallback-badge {
          background: rgb(24 24 27 / 0.95);
          color: #e4e4e7;
        }
      }

      .js .seo-prerender {
        position: fixed;
        inset: 0;
        z-index: -1;
        width: 100vw;
        height: 100svh;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        contain: layout size style paint;
      }

      .js .seo-prerender img {
        display: none;
      }
    </style>
    {hydrationData ? <script is:inline set:html={`window.__DELHI_METRO_ROUTE__=${JSON.stringify(hydrationData)};`} /> : null}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const registerServiceWorker = () => navigator.serviceWorker.register('/sw.js');

          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(registerServiceWorker, { timeout: 3000 });
          } else {
            window.setTimeout(registerServiceWorker, 1500);
          }
        });
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div set:html={body} />
    <App client:idle={{ timeout: 1800 }} />
  </body>
</html>
